# Copy this file to .env and fill in real values. .env is git-ignored.

# LLM (added in Step 5)
ANTHROPIC_API_KEY=

# Telephony (added in Step 9)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
